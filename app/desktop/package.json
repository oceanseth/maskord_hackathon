{
  "name": "@maskord/desktop",
  "version": "0.1.0",
  "description": "Maskord desktop application",
  "author": "Maskord",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:renderer": "vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "preview": "vite preview",
    "build:rooms": "vite build --config vite.rooms.config.ts",
    "dev:rooms": "vite --config vite.rooms.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "convex": "^1.45.0"
  },
  "devDependencies": {
    "@maskord/shared": "*",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "7zip-bin": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "date-fns": "^3.6.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.41",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-virtuoso": "^4.7.11",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vite-plugin-electron": "^0.28.7",
    "wait-on": "^7.2.0",
    "zustand": "^4.5.4"
  },
  "build": {
    "appId": "com.maskord.desktop",
    "productName": "Maskord",
    "electronVersion": "31.7.7",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Maskord-mac-${arch}.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Maskord-win-setup.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Maskord-linux.AppImage"
    }
  }
}
